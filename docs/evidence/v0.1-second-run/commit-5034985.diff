+    }
+  }),
+  baseArgs({ task: { maxCodingAttempts: 3 } }),
+  { status: 'OK', ok: true, attempts: 2, calls: 8 });
+
+// 8. 达到最大修订次数仍不通过
+await scenario('达到最大轮次仍不通过 → MAX_ATTEMPTS_REVIEW_NOT_APPROVED',
