+  { status: 'INCONSISTENT_REVIEW', ok: false, calls: 5 });
+
+// 7. 审核不通过 → 自动修订 → 第二轮通过
+await scenario('审核不通过后自动修订 → 第二轮 APPROVED 且 ok',
+  happyPlan({
+    review: function (attempt) {
+      if (attempt === 1) {
