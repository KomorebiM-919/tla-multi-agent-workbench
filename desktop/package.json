{
  "name": "tla-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "TLA 多智能体工作台桌面壳（V0.3 首批：团队模板与角色详情）",
  "main": "electron/main.mjs",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.mjs",
    "start": "electron .",
    "test": "node --test --test-isolation=none \"tests/**/*.test.mjs\"",
    "pack:dir": "npm run build:renderer && electron-builder --win dir"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.tailoredlogic.tla.workbench",
    "productName": "TLA",
    "asar": true,
    "beforeBuild": "scripts/before-build.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer-dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
